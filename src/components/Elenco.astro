---
// "Quem veste a camisa": membros fixos do time (src/data/elenco.json).
// Foto em src/assets/elenco/; sem foto, aparece a silhueta do capacete.
// Sem número de camisa, o card mostra as iniciais no lugar.
import { Picture } from 'astro:assets';
import Corte from './Corte.astro';
import Ph from './Ph.astro';
import Ilustracao from './Ilustracao.astro';
import { elenco, ehPlaceholder } from '../lib/dados';
import { imagem } from '../lib/imagens';

// "Isabela de Genaro" -> "IG" (primeiro e último nome)
const iniciais = (nome: string) => {
  const partes = nome.trim().split(/\s+/).filter(Boolean);
  if (partes.length === 0) return '';
  return `${partes[0][0]}${partes.length > 1 ? partes.at(-1)![0] : ''}`.toUpperCase();
};
const membros = elenco.map((m) => ({
  ...m,
  imagem: imagem(m.foto, 'elenco'),
  marca: m.numero !== null ? String(m.numero) : ehPlaceholder(m.nome) ? '' : iniciais(m.nome),
}));
---

<section class="secao elenco" id="elenco" aria-labelledby="elenco-titulo">
  <Corte posicao="topo" cor="var(--noite)" />
  <p class="elenco__fundo" aria-hidden="true" data-deslizar="25">07 12 15 88 01 09 03 14</p>

  <div class="container">
    <div class="elenco__cabeca">
      <h2 class="titulo-secao" id="elenco-titulo" data-titulo>
        <span class="linha">Quem veste</span>
        <span class="linha estencil">a camisa</span>
      </h2>
      <p class="elenco__intro" data-surge>Fundadores e administradores: os membros fixos que organizam o Choque.</p>
    </div>

    <ul class="membros" role="list">
      {
        membros.map((m) => (
          <li class="membro" data-revela>
            <span class="varredura" aria-hidden="true" />
            <article class="membro__card">
              <div class="membro__foto">
                {m.marca && (
                  <>
                    <span class="membro__marca membro__marca--contorno tabular" aria-hidden="true">
                      {m.marca}
                    </span>
                    <span class="membro__marca membro__marca--cheia tabular" aria-hidden="true">
                      {m.marca}
                    </span>
                  </>
                )}
                {m.imagem ? (
                  <Picture
                    src={m.imagem}
                    formats={['avif', 'webp']}
                    widths={[240, 360, 520]}
                    sizes="(min-width: 1024px) 28vw, (min-width: 700px) 30vw, 46vw"
                    alt={ehPlaceholder(m.nome) ? 'Foto do membro do time' : `Foto de ${m.nome}`}
                    class="membro__img"
                  />
                ) : (
                  <div class="membro__silhueta">
                    <Ilustracao nome="capacete" />
                    <span class="ph">[FOTO]</span>
                  </div>
                )}
                {m.capitao && (
                  <span class="membro__capitao" aria-hidden="true">
                    C
                  </span>
                )}
              </div>
              <div class="membro__dados">
                <h3 class="membro__nome">
                  <Ph texto={m.nome} />
                </h3>
                <p class="membro__funcao">
                  <Ph texto={m.funcao} />
                </p>
                {m.detalhe && (
                  <p class="membro__detalhe">
                    <Ph texto={m.detalhe} />
                  </p>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .elenco {
    padding-bottom: calc(var(--secao) + var(--corte));
  }
  .elenco__fundo {
    position: absolute;
    top: 3rem;
    right: 0;
    z-index: -1;
    max-width: none;
    white-space: nowrap;
    font-family: var(--t-numero);
    font-weight: 900;
    font-size: clamp(8rem, 30vw, 22rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 224 46 / 0.09);
    pointer-events: none;
    user-select: none;
  }
  .elenco__cabeca {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .elenco__intro {
    max-width: 38ch;
    color: var(--nevoa);
  }

  /* ---------- Cards ---------- */
  .membros {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 0.9rem;
    list-style: none;
    padding: 0;
  }
  .membro {
    position: relative;
  }
  .membro__card {
    display: grid;
    gap: 0.75rem;
  }
  .membro__foto {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background:
      linear-gradient(180deg, transparent 55%, rgb(11 14 26 / 0.85)),
      var(--noite-2);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
  }
  /* Número da camisa (ou iniciais) gigante no canto do card */
  .membro__marca {
    position: absolute;
    right: -0.04em;
    bottom: -0.12em;
    z-index: 0;
    font-family: var(--t-numero);
    font-weight: 900;
    font-size: clamp(5.5rem, 27vw, 9rem);
    line-height: 1;
    pointer-events: none;
    transition: opacity var(--medio) ease;
  }
  .membro__marca--contorno {
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 224 46 / 0.55);
  }
  .membro__marca--cheia {
    color: var(--amarelo);
    opacity: 0;
  }
  .membro__foto :global(.membro__img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .membro__silhueta {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.6rem;
    height: 100%;
    padding: 1rem;
    text-align: center;
  }
  .membro__silhueta :global(svg) {
    width: 62%;
    opacity: 0.5;
  }
  .membro__silhueta .ph {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .membro__capitao {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    background: var(--amarelo);
    color: var(--noite);
    font-family: var(--t-titulo);
    font-weight: 900;
    font-size: 1.4rem;
    line-height: 1;
  }
  .membro__nome {
    font-size: clamp(1.35rem, 4.6vw, 1.9rem);
    line-height: 0.95;
    overflow-wrap: anywhere;
  }
  .membro__funcao {
    margin-top: 0.45rem;
    font-family: var(--t-titulo);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--amarelo);
  }
  .membro__detalhe {
    margin-top: 0.35rem;
    font-size: var(--fs-pequeno);
    line-height: 1.4;
    color: var(--nevoa);
  }

  /* Hover/foco: o card leva um "choque" e o número acende */
  @media (hover: hover) {
    .membro:hover .membro__marca--cheia {
      opacity: 1;
    }
    .membro:hover .membro__marca--contorno {
      opacity: 0;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .membro:hover .membro__card {
      animation: choque 0.36s steps(1, end);
    }
  }
  @keyframes choque {
    0% { transform: translate(0, 0); }
    20% { transform: translate(-3px, 1px) rotate(-0.6deg); }
    40% { transform: translate(3px, -1px) rotate(0.5deg); }
    60% { transform: translate(-2px, 0) rotate(-0.3deg); }
    80% { transform: translate(1px, 1px); }
    100% { transform: none; }
  }

  @media (min-width: 700px) {
    .membros {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.25rem 1.25rem;
    }
    .membro__marca {
      font-size: clamp(6.5rem, 16vw, 11rem);
    }
  }
  @media (min-width: 1024px) {
    .elenco__cabeca {
      justify-items: end;
      text-align: right;
    }
    .membros {
      gap: 2.5rem 2rem;
    }
    /* escalação "em linha": a coluna do meio desce um pouco */
    .membro:nth-child(3n + 2) {
      margin-top: 3.5rem;
    }
    .membro__marca {
      font-size: clamp(8rem, 12vw, 13rem);
    }
  }
  @media (min-width: 1200px) {
    /* todos lado a lado, alternando a altura */
    .membros {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 2.5rem 1.25rem;
    }
    .membro:nth-child(3n + 2) {
      margin-top: 0;
    }
    .membro:nth-child(even) {
      margin-top: 3rem;
    }
    .membro__marca {
      font-size: clamp(6rem, 7.5vw, 8rem);
    }
    .membro__nome {
      font-size: 1.6rem;
    }
  }
</style>
