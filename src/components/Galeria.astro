---
// "Dentro e fora de campo": fotos e vídeos (src/data/galeria.json).
// Clique numa foto para ampliar (setas do teclado ou deslizar o dedo navegam).
import { Picture, getImage } from 'astro:assets';
import Corte from './Corte.astro';
import Ph from './Ph.astro';
import Icone from './Icone.astro';
import VideoLeve from './VideoLeve.astro';
import { galeria } from '../lib/dados';
import { imagem } from '../lib/imagens';

interface Props {
  fundo?: 'noite' | 'noite-2';
}
const { fundo = 'noite' } = Astro.props;

const itens = await Promise.all(
  galeria.map(async (item) => {
    if (item.tipo !== 'foto') return { ...item, img: undefined, grande: undefined };
    const img = imagem(item.arquivo, 'galeria');
    if (!img) return { ...item, img: undefined, grande: undefined };
    // versão grande (para ampliar), gerada no build em WebP
    const grande = await getImage({ src: img, width: Math.min(img.width, 1800), format: 'webp' });
    return { ...item, img, grande: grande.src };
  }),
);
---

<section class:list={['secao', 'galeria', `galeria--${fundo}`]} id="galeria" aria-labelledby="galeria-titulo">
  <Corte posicao="topo" cor={`var(--${fundo})`} />

  <div class="container">
    <h2 class="galeria__titulo" id="galeria-titulo">
      <span class="sr-only">Galeria: dentro e fora de campo</span>
      <span class="galeria__faixa" aria-hidden="true" data-deslizar="-38">
        Dentro e fora de campo <Icone nome="raio" class="galeria__raio" /> Dentro e fora de campo
        <Icone nome="raio" class="galeria__raio" />
      </span>
      <span class="titulo-secao galeria__parado" aria-hidden="true">
        <span class="linha contorno">Dentro e</span>
        <span class="linha">fora de campo</span>
      </span>
    </h2>

    <ul class="mosaico" role="list">
      {
        itens.map((item, i) => (
          <li class:list={['mosaico__item', { 'mosaico__item--destaque': i === 0, 'mosaico__item--video': item.tipo === 'video' }]} data-revela>
            <span class="varredura" aria-hidden="true" />
            {item.tipo === 'foto' && item.img && item.grande ? (
              <a class="foto" href={item.grande} data-ampliar data-legenda={item.legenda} data-largura={item.img.width} data-altura={item.img.height}>
                <Picture
                  src={item.img}
                  formats={['avif', 'webp']}
                  widths={i === 0 ? [480, 800, 1200] : [320, 480, 720]}
                  sizes={i === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
                  alt={item.legenda}
                />
                <span class="foto__legenda">{item.legenda}</span>
                <span class="sr-only"> (ampliar foto)</span>
              </a>
            ) : item.tipo === 'video' && item.youtubeId ? (
              <VideoLeve id={item.youtubeId} titulo={item.legenda} />
            ) : (
              <div class="foto foto--vazia">
                {item.tipo === 'video' && <Icone nome="play" tamanho={36} />}
                <Ph texto={item.legenda} />
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="ampliada" aria-label="Foto ampliada" data-ampliada>
    <figure class="ampliada__figura">
      <img class="ampliada__img" alt="" data-ampliada-img />
      <figcaption class="ampliada__legenda">
        <span data-ampliada-legenda></span>
        <span class="ampliada__contador tabular" data-ampliada-contador></span>
      </figcaption>
    </figure>
    <button class="ampliada__botao ampliada__botao--anterior" type="button" data-ampliada-anterior>
      <Icone nome="seta-esquerda" tamanho={30} /><span class="sr-only">Foto anterior</span>
    </button>
    <button class="ampliada__botao ampliada__botao--proxima" type="button" data-ampliada-proxima>
      <Icone nome="seta-direita" tamanho={30} /><span class="sr-only">Próxima foto</span>
    </button>
    <button class="ampliada__botao ampliada__botao--fechar" type="button" data-ampliada-fechar>
      <Icone nome="fechar" tamanho={28} /><span class="sr-only">Fechar</span>
    </button>
  </dialog>
</section>

<style>
  .galeria {
    padding-bottom: calc(var(--secao) + var(--corte));
  }
  .galeria--noite-2 {
    background: var(--noite-2);
  }
  .galeria--noite-2 .foto {
    background: var(--noite);
  }

  /* ---------- Título em faixa (corre com a rolagem) ---------- */
  .galeria__titulo {
    font-size: 1rem;
  }
  .galeria__faixa {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    white-space: nowrap;
    font-size: clamp(5rem, 24vw, 17rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 2px var(--giz);
  }
  .galeria__faixa :global(.galeria__raio) {
    flex: none;
    width: 0.55em;
    height: 0.55em;
    color: var(--amarelo);
  }
  .galeria__parado {
    display: none;
  }
  /* parado (modo calmo ou sem JavaScript): título normal em duas linhas */
  @media (prefers-reduced-motion: reduce) {
    .galeria__faixa {
      display: none;
    }
    .galeria__parado {
      display: block;
    }
  }
  :global(html:not(.js)) .galeria__faixa {
    display: none;
  }
  :global(html:not(.js)) .galeria__parado {
    display: block;
  }

  /* ---------- Mosaico assimétrico ---------- */
  .mosaico {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(9rem, 38vw, 15rem);
    grid-auto-flow: dense;
    gap: 0.6rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    list-style: none;
    padding: 0;
  }
  .mosaico__item {
    position: relative;
    min-width: 0;
  }
  .mosaico__item--destaque,
  .mosaico__item--video {
    grid-column: span 2;
  }
  .mosaico__item--destaque {
    grid-row: span 2;
  }
  .mosaico__item--video {
    grid-row: auto;
  }
  .mosaico__item--video :global(.video) {
    height: 100%;
    aspect-ratio: auto;
  }

  .foto {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--noite-2);
    color: var(--giz);
    text-decoration: none;
  }
  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .foto :global(img) {
    transition: transform 600ms var(--ease-choque);
  }
  .foto__legenda {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 0.9rem 0.75rem;
    background: linear-gradient(0deg, rgb(11 14 26 / 0.92), transparent);
    font-size: var(--fs-pequeno);
    font-weight: 600;
    line-height: 1.35;
  }
  @media (hover: hover) {
    .foto:hover :global(img) {
      transform: scale(1.06);
    }
  }
  .foto:focus-visible {
    outline-offset: -4px;
  }
  .foto--vazia {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    padding: 1rem;
    text-align: center;
    border: 2px dashed var(--noite-3);
    color: var(--amarelo);
  }

  /* ---------- Foto ampliada ---------- */
  .ampliada {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(11 14 26 / 0.97);
    color: var(--giz);
    overscroll-behavior: contain;
  }
  .ampliada[open] {
    display: grid;
    place-items: center;
  }
  .ampliada::backdrop {
    background: rgb(11 14 26 / 0.8);
  }
  .ampliada__figura {
    display: grid;
    gap: 0.75rem;
    width: min(100% - 2rem, 80rem);
    margin: 0;
  }
  .ampliada__img {
    width: 100%;
    max-height: 78svh;
    object-fit: contain;
  }
  .ampliada__legenda {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
  }
  .ampliada__contador {
    color: var(--nevoa);
  }
  .ampliada__botao {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: var(--amarelo);
    color: var(--noite);
  }
  .ampliada__botao--fechar {
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
  }
  .ampliada__botao--anterior,
  .ampliada__botao--proxima {
    bottom: max(1rem, env(safe-area-inset-bottom));
  }
  .ampliada__botao--anterior {
    left: 1rem;
  }
  .ampliada__botao--proxima {
    right: 1rem;
  }
  .ampliada__botao:focus-visible {
    outline-color: var(--giz);
  }

  @media (min-width: 900px) {
    .mosaico {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(11rem, 16vw, 15rem);
      gap: 0.8rem;
    }
    .mosaico__item--video {
      grid-row: span 2;
    }
    .ampliada__botao--anterior,
    .ampliada__botao--proxima {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
  }
</style>

<script>
  // Foto ampliada: abre num <dialog>, navega com setas, teclado e gesto.
  const dialogo = document.querySelector<HTMLDialogElement>('[data-ampliada]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-ampliar]'));
  if (dialogo && links.length) {
    const img = dialogo.querySelector<HTMLImageElement>('[data-ampliada-img]')!;
    const legenda = dialogo.querySelector<HTMLElement>('[data-ampliada-legenda]')!;
    const contador = dialogo.querySelector<HTMLElement>('[data-ampliada-contador]')!;
    const variasFotos = links.length > 1;
    let atual = 0;
    let origem: HTMLElement | null = null;

    dialogo.querySelectorAll<HTMLElement>('[data-ampliada-anterior], [data-ampliada-proxima]').forEach((b) => {
      b.hidden = !variasFotos;
    });

    function mostrar(indice: number) {
      atual = (indice + links.length) % links.length;
      const link = links[atual];
      img.width = Number(link.dataset.largura) || 1600;
      img.height = Number(link.dataset.altura) || 1200;
      img.src = link.href;
      img.alt = link.dataset.legenda ?? '';
      legenda.textContent = link.dataset.legenda ?? '';
      contador.textContent = variasFotos ? `${atual + 1} de ${links.length}` : '';
    }

    links.forEach((link, i) =>
      link.addEventListener('click', (evento) => {
        evento.preventDefault();
        origem = link;
        mostrar(i);
        dialogo.showModal();
        document.documentElement.classList.add('menu-aberto');
      }),
    );
    dialogo.querySelector('[data-ampliada-anterior]')?.addEventListener('click', () => mostrar(atual - 1));
    dialogo.querySelector('[data-ampliada-proxima]')?.addEventListener('click', () => mostrar(atual + 1));
    dialogo.querySelector('[data-ampliada-fechar]')?.addEventListener('click', () => dialogo.close());
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
    dialogo.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowLeft') mostrar(atual - 1);
      if (evento.key === 'ArrowRight') mostrar(atual + 1);
    });
    dialogo.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-aberto');
      origem?.focus();
    });

    // Deslizar o dedo para os lados troca de foto
    let inicioX: number | null = null;
    dialogo.addEventListener('pointerdown', (e) => (inicioX = e.clientX));
    dialogo.addEventListener('pointerup', (e) => {
      if (inicioX === null || !variasFotos) return;
      const delta = e.clientX - inicioX;
      if (Math.abs(delta) > 50) mostrar(atual + (delta < 0 ? 1 : -1));
      inicioX = null;
    });
  }
</script>
