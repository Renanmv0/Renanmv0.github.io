---
// Ícones em SVG embutido (sem requisições extras). Sempre decorativos:
// o texto ao lado (ou um aria-label no botão) é que diz o que a ação faz.
interface Props {
  nome:
    | 'raio'
    | 'whatsapp'
    | 'instagram'
    | 'email'
    | 'mapa'
    | 'calendario'
    | 'relogio'
    | 'play'
    | 'pausa'
    | 'fechar'
    | 'seta-baixo'
    | 'seta-esquerda'
    | 'seta-direita'
    | 'externo';
  class?: string;
  tamanho?: number;
}

const { nome, class: classe, tamanho = 24 } = Astro.props;
const preenchido = ['raio', 'whatsapp', 'play', 'pausa'].includes(nome);
---

<svg
  class:list={['icone', classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={preenchido ? 'currentColor' : 'none'}
  stroke={preenchido ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {nome === 'raio' && <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />}
  {
    nome === 'whatsapp' && (
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.34M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z" />
    )
  }
  {
    nome === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    nome === 'email' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <polyline points="3 7 12 13 21 7" />
      </>
    )
  }
  {
    nome === 'mapa' && (
      <>
        <path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
  {
    nome === 'calendario' && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <line x1="3" y1="10" x2="21" y2="10" />
        <line x1="8" y1="3" x2="8" y2="7" />
        <line x1="16" y1="3" x2="16" y2="7" />
      </>
    )
  }
  {
    nome === 'relogio' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <polyline points="12 7 12 12 15 14" />
      </>
    )
  }
  {nome === 'play' && <polygon points="7 4 20 12 7 20 7 4" />}
  {
    nome === 'pausa' && (
      <>
        <rect x="6" y="4" width="4" height="16" />
        <rect x="14" y="4" width="4" height="16" />
      </>
    )
  }
  {
    nome === 'fechar' && (
      <>
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </>
    )
  }
  {nome === 'seta-baixo' && <polyline points="6 9 12 15 18 9" />}
  {nome === 'seta-esquerda' && <polyline points="15 6 9 12 15 18" />}
  {nome === 'seta-direita' && <polyline points="9 6 15 12 9 18" />}
  {
    nome === 'externo' && (
      <>
        <path d="M14 4h6v6" />
        <line x1="20" y1="4" x2="11" y2="13" />
        <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
      </>
    )
  }
</svg>
