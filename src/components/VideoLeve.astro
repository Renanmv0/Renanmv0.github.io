---
// Vídeo do YouTube "leve": mostra uma capa desenhada e só carrega o player
// quando a pessoa clica (a página abre mais rápido e sem rastreadores).
// Sem JavaScript, o link abre o vídeo no YouTube.
import Icone from './Icone.astro';

interface Props {
  id: string;
  titulo: string;
  legenda?: string;
}
const { id, titulo, legenda = 'Vídeo do YouTube' } = Astro.props;
---

{
  id && (
    <div class="video" data-video={id} data-video-titulo={titulo}>
      <a class="video__capa" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">
        <span class="video__play" aria-hidden="true">
          <Icone nome="play" tamanho={34} />
        </span>
        <span class="video__textos">
          <span class="video__titulo">{titulo}</span>
          <span class="video__legenda">{legenda}</span>
        </span>
      </a>
    </div>
  )
}

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: var(--noite);
    /* linhas de campo desenhadas em CSS (sem imagem) */
    background-image:
      radial-gradient(circle at 50% 50%, transparent 0 17%, rgb(241 242 246 / 0.16) 17% calc(17% + 2px), transparent calc(17% + 2px)),
      linear-gradient(90deg, transparent calc(50% - 1px), rgb(241 242 246 / 0.16) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)),
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
    border: 2px solid var(--noite-3);
    overflow: hidden;
  }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__capa {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1rem, 4vw, 2rem);
    color: var(--giz);
    text-decoration: none;
  }
  .video__play {
    order: 2;
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(3.75rem, 12vw, 6rem);
    aspect-ratio: 1;
    padding-left: 0.3rem;
    background: var(--amarelo);
    color: var(--noite);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
    transition: transform var(--medio) var(--ease-choque);
  }
  .video__capa:hover .video__play {
    transform: scale(1.08) rotate(-3deg);
  }
  .video__capa:focus-visible {
    outline-offset: -6px;
  }
  .video__textos {
    display: grid;
    gap: 0.2rem;
  }
  .video__titulo {
    font-family: var(--t-titulo);
    font-weight: 900;
    font-size: clamp(1.5rem, 4.5vw, 2.4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .video__legenda {
    font-size: var(--fs-pequeno);
    color: var(--nevoa);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((caixa) => {
    const capa = caixa.querySelector('a');
    capa?.addEventListener('click', (evento) => {
      evento.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${caixa.dataset.video}?autoplay=1&rel=0`;
      iframe.title = caixa.dataset.videoTitulo || 'Vídeo do YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      capa.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
